<Window x:Class="RoboCopyManager.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About RoboCopy Manager"
        Width="560"
        Height="600"
        MinWidth="560"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F6FA"
        FontFamily="Segoe UI">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,20">

            <Border Width="64"
                    Height="64"
                    CornerRadius="14"
                    Background="#1F2937"
                    HorizontalAlignment="Center">

                <TextBlock Text="RC"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="RoboCopy Manager"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#1F2937"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,0"/>

            <TextBlock Text="Fast and reliable file transfer"
                       FontSize="13"
                       Foreground="#6B7280"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>

            <Border Background="#E5EDF8"
                    CornerRadius="12"
                    Padding="12,5"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0">

                <TextBlock Text="VERSION 1.0.0"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"/>
            </Border>

        </StackPanel>

        <!-- INFORMATION CARD -->
        <Border Grid.Row="1"
        Background="White"
        BorderBrush="#D9E0E7"
        BorderThickness="1"
        CornerRadius="8"
        Padding="18"
        Margin="0,0,0,20">

            <StackPanel VerticalAlignment="Center"
                        Margin="0,5,0,5">

                <!-- SECTION TITLE -->
                <TextBlock Text="Application Information"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="#1F2937"
                   Margin="0,0,0,12"/>

                <!-- DEVELOPER -->
                <TextBlock Text="Developed by"
                   FontSize="11"
                   Foreground="#6B7280"/>

                <TextBlock Text="Abdul Marwan bin Mohamad Shah"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#1F2937"
                   TextWrapping="Wrap"
                   Margin="0,3,0,10"/>

                <!-- TECHNOLOGY -->
                <TextBlock Text="Technology"
                   FontSize="11"
                   Foreground="#6B7280"/>

                <TextBlock Text="C# · WPF · Windows Robocopy"
                   FontSize="12"
                   Foreground="#1F2937"
                   Margin="0,3,0,10"/>

                <!-- PLATFORM -->
                <TextBlock Text="Platform"
                   FontSize="11"
                   Foreground="#6B7280"/>

                <TextBlock Text="Microsoft Windows"
                   FontSize="12"
                   Foreground="#1F2937"
                   Margin="0,3,0,12"/>

                <Separator Background="#E5E7EB"
                   Margin="0,0,0,10"/>

                <!-- COPYRIGHT -->
                <TextBlock Text="© 2026 Abdul Marwan bin Mohamad Shah"
                   FontSize="10"
                   Foreground="#6B7280"
                   TextWrapping="Wrap"/>

                <TextBlock Text="All Rights Reserved."
                   FontSize="10"
                   Foreground="#6B7280"
                   Margin="0,3,0,0"/>

            </StackPanel>

        </Border>

        <!-- CLOSE BUTTON -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Close"
                    Width="100"
                    Height="36"
                    IsDefault="True"
                    Click="Close_Click"/>

        </StackPanel>

    </Grid>

</Window>