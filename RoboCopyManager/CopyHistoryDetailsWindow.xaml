<Window x:Class="RoboCopyManager.CopyHistoryDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy History Details"
        Height="700"
        Width="900"
        MinHeight="650"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB"
        FontFamily="Segoe UI">

    <Window.Resources>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#16A34A"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

    </Window.Resources>

    <Grid Margin="26">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,22">

            <StackPanel>
                <TextBlock Text="Copy History Details"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#1E293B"/>

                <TextBlock Text="Detailed information about this copy operation"
                           FontSize="13"
                           Foreground="#64748B"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Border x:Name="StatusBadge"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    CornerRadius="20"
                    Padding="12,7"
                    Background="#DCFCE7">

                <StackPanel Orientation="Horizontal">

                    <Ellipse x:Name="StatusDot"
                 Width="8"
                 Height="8"
                 Fill="#16A34A"
                 VerticalAlignment="Center"
                 Margin="0,0,8,0"/>

                    <TextBlock x:Name="StatusText"
                   Text="Completed"
                   Foreground="#166534"
                   FontWeight="SemiBold"
                   FontSize="12"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- STATISTICS -->
        <Grid Grid.Row="1" Margin="0,0,0,18">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,6,0">

                <StackPanel>
                    <TextBlock Text="TOTAL FILES"
                               Style="{StaticResource LabelStyle}"/>

                    <TextBlock x:Name="TotalFilesText"
                               Text="0"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#1E293B"/>

                    <TextBlock Text="Files in copy plan"
                               FontSize="11"
                               Foreground="#94A3B8"
                               Margin="0,5,0,0"/>
                </StackPanel>

            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource CardStyle}"
                    Margin="3,0">

                <StackPanel>
                    <TextBlock Text="COPIED FILES"
                               Style="{StaticResource LabelStyle}"/>

                    <TextBlock x:Name="CopiedFilesText"
                               Text="0"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#16A34A"/>

                    <TextBlock Text="Files copied successfully"
                               FontSize="11"
                               Foreground="#94A3B8"
                               Margin="0,5,0,0"/>
                </StackPanel>

            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource CardStyle}"
                    Margin="3,0">

                <StackPanel>
                    <TextBlock Text="FAILED FILES"
                               Style="{StaticResource LabelStyle}"/>

                    <TextBlock x:Name="FailedFilesText"
                               Text="0"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#DC2626"/>

                    <TextBlock Text="Files that failed"
                               FontSize="11"
                               Foreground="#94A3B8"
                               Margin="0,5,0,0"/>
                </StackPanel>

            </Border>

            <!-- NOT PROCESSED -->
            <Border Grid.Column="3"
        Style="{StaticResource CardStyle}"
        Margin="6,0,0,0">

                <StackPanel>
                    <TextBlock Text="NOT PROCESSED"
                   Style="{StaticResource LabelStyle}"/>

                    <TextBlock x:Name="NotProcessedFilesText"
                   Text="0"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#EA580C"/>

                    <TextBlock Text="Estimated remaining files"
                   FontSize="11"
                   Foreground="#94A3B8"
                   Margin="0,5,0,0"/>
                </StackPanel>

            </Border>

        </Grid>

        <!-- OPERATION DETAILS -->
        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,18">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Operation Information"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#1E293B"
                           Margin="0,0,0,20"/>

                <!-- SOURCE -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <TextBlock Text="SOURCE"
                               Style="{StaticResource LabelStyle}"/>

                    <TextBlock x:Name="SourceText"
                               Style="{StaticResource ValueStyle}"
                               Text="Source path"/>
                </StackPanel>

                <!-- DESTINATION -->
                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <TextBlock Text="DESTINATION"
                               Style="{StaticResource LabelStyle}"/>

                    <TextBlock x:Name="DestinationText"
                               Style="{StaticResource ValueStyle}"
                               Text="Destination path"/>
                </StackPanel>

                <!-- DATA AND DURATION -->
                <Grid Grid.Row="3" Margin="0,0,0,16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DATA TRANSFERRED"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBlock x:Name="DataTransferredText"
                                   Style="{StaticResource ValueStyle}"
                                   Text="0 bytes"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="DURATION"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBlock x:Name="DurationText"
                                   Style="{StaticResource ValueStyle}"
                                   Text="00:00:00"/>
                    </StackPanel>

                </Grid>

                <!-- DATE AND TIME -->
                <Grid Grid.Row="4" Margin="0,0,0,16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="START TIME"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBlock x:Name="StartTimeText"
                                   Style="{StaticResource ValueStyle}"
                                   Text="-"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="END TIME"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBlock x:Name="EndTimeText"
                                   Style="{StaticResource ValueStyle}"
                                   Text="-"/>
                    </StackPanel>

                </Grid>

                <!-- REMARKS -->
                <StackPanel Grid.Row="5">
                    <TextBlock Text="REMARKS"
                               Style="{StaticResource LabelStyle}"/>

                    <TextBlock x:Name="RemarksText"
                               Style="{StaticResource ValueStyle}"
                               Text="No remarks"/>
                </StackPanel>

            </Grid>

        </Border>

        <!-- FOOTER -->
        <Grid Grid.Row="3">

            <TextBlock Text="RoboCopy Manager"
                       Foreground="#94A3B8"
                       FontSize="12"
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Open Full Log"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#E2E8F0"
                        Foreground="#1E293B"
                        Click="OpenFullLog_Click"/>

                <Button Content="Close"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#1E293B"
                        Foreground="White"
                        Margin="0"
                        Click="Close_Click"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>