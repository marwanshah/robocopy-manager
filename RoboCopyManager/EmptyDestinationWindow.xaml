<Window x:Class="RoboCopyManager.EmptyDestinationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Empty Destination"
        Width="560"
        Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F6FA">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="Destination Folder is Empty"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#1F2937"/>

            <TextBlock x:Name="SummaryText"
                       FontSize="14"
                       Foreground="#6B7280"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"/>

        </StackPanel>


        <!-- MESSAGE -->
        <Border Grid.Row="1"
                Margin="0,20,0,20"
                Padding="15"
                Background="White"
                BorderBrush="#D9E0E7"
                BorderThickness="1"
                CornerRadius="8">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="No files were found in the destination folder."
                           FontSize="13"
                           Foreground="#374151"
                           TextWrapping="Wrap"/>

                <TextBlock Text="The selected files will be copied to this destination."
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"/>

            </StackPanel>

        </Border>


        <!-- BUTTONS -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancel"
                    Width="100"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="Continue"
                    Width="110"
                    Height="36"
                    Click="Continue_Click"/>

        </StackPanel>

    </Grid>

</Window>