<Window x:Class="RoboCopyManager.AddJobWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Copy Job"
        Width="720"
        Height="520"
        MinWidth="650"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F3F6FA"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- ========================= -->
        <!-- TEXT BOX -->
        <!-- ========================= -->

        <Style x:Key="PathTextBox"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="BorderBrush"
                    Value="#C8D2DF"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Background"
                    Value="#FFFFFF"/>

        </Style>


        <!-- ========================= -->
        <!-- BROWSE BUTTON -->
        <!-- ========================= -->

        <Style x:Key="BrowseButton"
               TargetType="Button">

            <Setter Property="Width"
                    Value="115"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#C8D2DF"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BrowseBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <Border.Effect>

                                <DropShadowEffect
                                    BlurRadius="5"
                                    ShadowDepth="1"
                                    Opacity="0.12"/>

                            </Border.Effect>

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BrowseBorder"
                                        Property="Background"
                                        Value="#F4F8FD"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="BrowseBorder"
                                        Property="Background"
                                        Value="#E8F1FC"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================= -->
        <!-- PRIMARY -->
        <!-- ========================= -->

        <Style x:Key="PrimaryButton"
               TargetType="Button">

            <Setter Property="Width"
                    Value="120"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Background"
                    Value="#1677E8"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="PrimaryBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">

                            <Border.Effect>

                                <DropShadowEffect
                                    BlurRadius="8"
                                    ShadowDepth="2"
                                    Opacity="0.22"/>

                            </Border.Effect>

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="PrimaryBorder"
                                        Property="Background"
                                        Value="#0D6EDB"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="PrimaryBorder"
                                        Property="Background"
                                        Value="#095EBE"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================= -->
        <!-- CANCEL -->
        <!-- ========================= -->

        <Style x:Key="CancelButton"
               TargetType="Button">

            <Setter Property="Width"
                    Value="120"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#172033"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="CancelBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="CancelBorder"
                                        Property="Background"
                                        Value="#F5F8FC"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- ========================= -->
    <!-- MAIN CARD -->
    <!-- ========================= -->

    <Border Margin="15"
            Background="#FFFFFF"
            CornerRadius="12"
            BorderBrush="#D7DEE8"
            BorderThickness="1">

        <Border.Effect>

            <DropShadowEffect
                BlurRadius="20"
                ShadowDepth="5"
                Opacity="0.18"/>

        </Border.Effect>


        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ========================= -->
            <!-- HEADER -->
            <!-- ========================= -->

            <Border Grid.Row="0"
                    Padding="25,22"
                    BorderBrush="#E3E8EF"
                    BorderThickness="0,0,0,1">

                <StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <Border Width="54"
                                Height="54"
                                Background="#EAF4FF"
                                CornerRadius="12"
                                Margin="0,0,15,0">

                            <TextBlock Text="📁"
                                       FontSize="30"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>


                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="Add Copy Job"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#172033"/>

                            <TextBlock Text="Select the source and destination folders."
                                       FontSize="13"
                                       Foreground="#667085"
                                       Margin="0,3,0,0"/>

                        </StackPanel>

                    </StackPanel>

                </StackPanel>

            </Border>


            <!-- ========================= -->
            <!-- CONTENT -->
            <!-- ========================= -->

            <Grid Grid.Row="1"
                  Margin="25,25,25,15">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- SOURCE -->

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,15">

                    <TextBlock Text="Source Type"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#344054"
                               VerticalAlignment="Center"
                               Width="105"/>

                    <RadioButton x:Name="FolderRadioButton"
                                Content="Folder"
                                IsChecked="True"
                                VerticalAlignment="Center"
                                Margin="0,0,25,0"/>

                    <RadioButton x:Name="FilesRadioButton"
                                 Content="File(s)"
                                 VerticalAlignment="Center"/>

                </StackPanel>

                <Grid Grid.Row="1"
                      Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="115"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0"
                               Text="Source"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#344054"
                               VerticalAlignment="Center"/>


                    <TextBox x:Name="SourceTextBox"
                             Grid.Column="1"
                             Style="{StaticResource PathTextBox}"
                             ToolTip="Example: D:\Data"
                             Margin="0,0,10,0"/>


                    <Button Grid.Column="2"
                            Content="📁  Browse..."
                            Style="{StaticResource BrowseButton}"
                            Click="BrowseSource_Click"/>

                </Grid>


                <!-- DESTINATION -->

                <Grid Grid.Row="2"
                      Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="115"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0"
                               Text="Destination"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#344054"
                               VerticalAlignment="Center"/>


                    <TextBox x:Name="DestinationTextBox"
                             Grid.Column="1"
                             Style="{StaticResource PathTextBox}"
                             ToolTip="Example: E:\Backup"
                             Margin="0,0,10,0"/>


                    <Button Grid.Column="2"
                            Content="📁  Browse..."
                            Style="{StaticResource BrowseButton}"
                            Click="BrowseDestination_Click"/>

                </Grid>


                <!-- OPTIONS -->

                <Border Grid.Row="3"
                        Background="#F8FAFD"
                        BorderBrush="#E1E7EF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15">

                    <StackPanel>

                        <TextBlock Text="Transfer Options"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#344054"/>

                        <TextBlock Text="Advanced Robocopy settings can be configured after the job is created."
                                   FontSize="12"
                                   Foreground="#667085"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- ========================= -->
            <!-- FOOTER -->
            <!-- ========================= -->

            <Border Grid.Row="2"
                    Background="#F8FAFD"
                    Padding="25,15"
                    BorderBrush="#E3E8EF"
                    BorderThickness="0,1,0,0">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Cancel"
                            Style="{StaticResource CancelButton}"
                            Margin="0,0,10,0"
                            Click="Cancel_Click"/>

                    <Button Content="Add Job"
                            Style="{StaticResource PrimaryButton}"
                            Click="AddJob_Click"/>

                </StackPanel>

            </Border>

        </Grid>

    </Border>

</Window>