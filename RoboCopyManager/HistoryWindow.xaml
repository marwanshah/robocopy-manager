<Window x:Class="RoboCopyManager.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy History"
        Height="650"
        Width="1100"
        MinHeight="500"
        MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Copy History"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#172B4D"/>

                <TextBlock Text="Review previous copy operations and logs."
                           FontSize="13"
                           Foreground="#64748B"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button Content="Export CSV"
                        Width="110"
                        Height="36"
                        Margin="0,0,10,0"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ExportCsv_Click"/>

                <Button Content="Refresh"
                        Width="100"
                        Height="36"
                        Background="White"
                        Foreground="#334155"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="Refresh_Click"/>

            </StackPanel>

        </Grid>

        <!-- Summary -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="TOTAL ATTEMPTS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#64748B"/>

                    <TextBlock x:Name="TotalAttemptsText"
                               Text="0"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#172B4D"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="Local History"
                           FontSize="12"
                           Foreground="#64748B"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- History Table -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">

            <DataGrid x:Name="HistoryDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      Background="White"
                      BorderThickness="0"
                      RowHeight="42"
                      ColumnHeaderHeight="38"
                      FontSize="12"
                      SelectionChanged="HistoryDataGrid_SelectionChanged"
                      MouseDoubleClick="HistoryDataGrid_MouseDoubleClick">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="DATE &amp; TIME"
                                        Binding="{Binding StartTime,
                                            StringFormat={}{0:dd/MM/yyyy hh:mm tt}}"
                                        Width="155"/>

                    <DataGridTextColumn Header="SOURCE"
                                        Binding="{Binding Source}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="DESTINATION"
                                        Binding="{Binding Destination}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="STATUS"
                                        Binding="{Binding Status}"
                                        Width="100"/>

                    <DataGridTextColumn Header="DURATION"
                                        Binding="{Binding DurationSeconds,
                                            StringFormat={}{0:F1} sec}"
                                        Width="90"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="SelectedLogText"
                           Text="Select a history record to view its log."
                           FontSize="12"
                           Foreground="#64748B"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Text="Logs are stored locally on this computer."
                           FontSize="11"
                           Foreground="#94A3B8"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Open Log"
                    Width="110"
                    Height="36"
                    Margin="12,0,8,0"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OpenLog_Click"/>

            <Button Grid.Column="2"
                    Content="Close"
                    Width="90"
                    Height="36"
                    Background="White"
                    Foreground="#334155"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="Close_Click"/>
        </Grid>

    </Grid>
</Window>