<Window x:Class="RoboCopyManager.ConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Conflicts"
        Width="900"
        Height="550"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FA">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,15">

            <TextBlock Text="Files Need Your Decision"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#1F2937"/>

            <TextBlock x:Name="SummaryText"
                       Text="The following files are different."
                       FontSize="13"
                       Foreground="#6B7280"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- File List -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D9E0E7"
                BorderThickness="1"
                CornerRadius="8">

            <DataGrid x:Name="ConflictDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="White">

                <DataGrid.Columns>

                    <!-- OVERWRITE -->
                    <DataGridTemplateColumn Header="Overwrite"
                            Width="90">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <CheckBox IsChecked="{Binding IsOverwriteSelected,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- FILE -->
                    <DataGridTextColumn Header="File"
                        Binding="{Binding RelativePath}"
                        Width="*"/>


                    <!-- SOURCE SIZE -->
                    <DataGridTextColumn Header="Source Size"
                        Binding="{Binding SourceSize}"
                        Width="120"/>


                    <!-- DESTINATION SIZE -->
                    <DataGridTextColumn Header="Destination Size"
                        Binding="{Binding DestinationSize}"
                        Width="140"/>


                    <!-- SOURCE MODIFIED -->
                    <DataGridTextColumn Header="Source Modified"
                        Binding="{Binding SourceModified}"
                        Width="170"/>


                    <!-- DESTINATION MODIFIED -->
                    <DataGridTextColumn Header="Destination Modified"
                        Binding="{Binding DestinationModified}"
                        Width="180"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Skip All"
                    Width="100"
                    Height="36"
                    Margin="0,0,8,0"
                    Click="SkipAll_Click"/>

            <Button Content="Overwrite All"
                    Width="120"
                    Height="36"
                    Margin="0,0,20,0"
                    Click="OverwriteAll_Click"/>

            <Button Content="Cancel"
                    Width="90"
                    Height="36"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>

            <Button Content="Continue"
                    Width="100"
                    Height="36"
                    Click="Continue_Click"/>

        </StackPanel>

    </Grid>

</Window>
