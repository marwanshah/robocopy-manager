<Window x:Class="RoboCopyManager.CopyReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy Review"
        Width="600"
        Height="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F6FA">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,18">

            <TextBlock Text="Copy Review"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#1F2937"/>

            <TextBlock Text="Review the changes before starting the copy."
                       FontSize="13"
                       Foreground="#6B7280"
                       Margin="0,6,0,0"/>

        </StackPanel>


        <!-- SUMMARY -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D9E0E7"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- NEW FILES -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="New Files to Copy"
                               FontSize="15"
                               Foreground="#374151"/>

                    <TextBlock x:Name="NewFilesText"
                               Grid.Column="1"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>

                </Grid>


                <!-- EXISTING SAME -->
                <Grid Grid.Row="1"
                      Margin="0,0,0,15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Existing Files Unchanged"
                               FontSize="15"
                               Foreground="#374151"/>

                    <TextBlock x:Name="SameFilesText"
                               Grid.Column="1"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>

                </Grid>


                <!-- DIFFERENT -->
                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Files Requiring Decision"
                               FontSize="15"
                               Foreground="#374151"/>

                    <TextBlock x:Name="DifferentFilesText"
                               Grid.Column="1"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>

                </Grid>


                <!-- SEPARATOR -->
                <Border Grid.Row="3"
                        Height="1"
                        Background="#E5E7EB"
                        Margin="0,0,0,15"/>


                <!-- TOTAL -->
                <Grid Grid.Row="4">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Total Source Files"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>

                    <TextBlock x:Name="TotalFilesText"
                               Grid.Column="1"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>

                </Grid>


                <!-- MESSAGE -->
                <StackPanel Grid.Row="5"
                            Margin="0,20,0,0">

                    <TextBlock Text="✓ Existing matching files will NOT be overwritten."
                               FontSize="13"
                               Foreground="#374151"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="✓ Existing folders will be reused."
                               FontSize="13"
                               Foreground="#374151"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="DecisionMessageText"
                               FontSize="13"
                               Foreground="#6B7280"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- BUTTONS -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Cancel"
                    Width="100"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="Continue"
                    Width="110"
                    Height="36"
                    Click="Continue_Click"/>

        </StackPanel>

    </Grid>

</Window>
