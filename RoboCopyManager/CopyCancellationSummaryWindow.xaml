<Window x:Class="RoboCopyManager.CopyCancellationSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy Cancellation Summary"
        Width="600"
        Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F6FA">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="Copy Operation Cancelled"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#1F2937"/>

            <TextBlock Text="The copy operation was stopped before completion."
                       FontSize="14"
                       Foreground="#6B7280"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"/>

        </StackPanel>

        <!-- STATISTICS -->
        <Border Grid.Row="1"
                Margin="0,20,0,20"
                Padding="18"
                Background="White"
                BorderBrush="#D9E0E7"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="False">

            <StackPanel>

                <TextBlock Text="Transfer Summary"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           Margin="0,0,0,15"/>

                <Grid VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TOTAL FILES -->
                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,8,10"
                            Padding="12"
                            Background="#F3F6FA"
                            CornerRadius="6">

                        <StackPanel>
                            <TextBlock Text="Total Files"
                                       FontSize="12"
                                       Foreground="#6B7280"/>

                            <TextBlock x:Name="TotalFilesText"
                                       Text="0"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- FULLY COPIED -->
                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Margin="8,0,0,10"
                            Padding="12"
                            Background="#ECFDF5"
                            CornerRadius="6">

                        <StackPanel>
                            <TextBlock Text="Fully Copied"
                                       FontSize="12"
                                       Foreground="#047857"/>

                            <TextBlock x:Name="FullyCopiedText"
                                       Text="0"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#047857"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- PARTIALLY COPIED -->
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,8,10"
                            Padding="12"
                            Background="#FFFBEB"
                            CornerRadius="6">

                        <StackPanel>
                            <TextBlock Text="Partially Copied"
                                       FontSize="12"
                                       Foreground="#B45309"/>

                            <TextBlock x:Name="PartiallyCopiedText"
                                       Text="0"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#B45309"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- NOT COPIED -->
                    <Border Grid.Row="1"
                            Grid.Column="1"
                            Margin="8,0,0,10"
                            Padding="12"
                            Background="#FEF2F2"
                            CornerRadius="6">

                        <StackPanel>
                            <TextBlock Text="Not Copied"
                                       FontSize="12"
                                       Foreground="#B91C1C"/>

                            <TextBlock x:Name="NotCopiedText"
                                       Text="0"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#B91C1C"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- DATA TRANSFERRED -->
                    <Border Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            Padding="12"
                            Background="#F3F6FA"
                            CornerRadius="6">

                        <StackPanel>
                            <TextBlock Text="Data Transferred"
                                       FontSize="12"
                                       Foreground="#6B7280"/>

                            <TextBlock x:Name="DataTransferredText"
                                       Text="0 MB"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- DURATION -->
                    <Border Grid.Row="2"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Padding="12"
                            Background="#F3F6FA"
                            CornerRadius="6">

                        <StackPanel>
                            <TextBlock Text="Duration"
                                       FontSize="12"
                                       Foreground="#6B7280"/>

                            <TextBlock x:Name="DurationText"
                                       Text="00:00:00"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                </Grid>

                <TextBlock Text="File completion is estimated using destination file sizes."
                           FontSize="11"
                           Foreground="#6B7280"
                           TextWrapping="Wrap"
                           Margin="0,15,0,0"/>

            </StackPanel>

        </Border>

        <!-- CLOSE BUTTON -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Close"
                    Width="100"
                    Height="36"
                    IsDefault="True"
                    Click="Close_Click"/>

        </StackPanel>

    </Grid>

</Window>