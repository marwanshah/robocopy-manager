<Window x:Class="RoboCopyManager.CopySummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy Summary"
        Width="620"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F6FA">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock x:Name="TitleText"
                       Text="Copy Completed"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#1F2937"/>

            <TextBlock x:Name="StatusText"
                       Text="The copy operation completed successfully."
                       FontSize="13"
                       Foreground="#6B7280"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"/>

        </StackPanel>


        <!-- SUMMARY -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D9E0E7"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- NEW FILES -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="New Files Copied"
                               FontSize="15"
                               Foreground="#374151"/>

                    <TextBlock x:Name="NewFilesText"
                               Grid.Column="1"
                               Text="0"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>

                </Grid>


                <!-- OVERWRITTEN -->
                <Grid Grid.Row="1"
                      Margin="0,0,0,15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Files Overwritten"
                               FontSize="15"
                               Foreground="#374151"/>

                    <TextBlock x:Name="OverwrittenText"
                               Grid.Column="1"
                               Text="0"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>

                </Grid>


                <!-- SKIPPED -->
                <Grid Grid.Row="2"
                      Margin="0,0,0,15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Files Skipped"
                               FontSize="15"
                               Foreground="#374151"/>

                    <TextBlock x:Name="SkippedText"
                               Grid.Column="1"
                               Text="0"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>

                </Grid>


                <!-- FAILED -->
                <Grid Grid.Row="3">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Failed"
                               FontSize="15"
                               Foreground="#374151"/>

                    <TextBlock x:Name="FailedText"
                               Grid.Column="1"
                               Text="0"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>

                </Grid>


                <!-- SEPARATOR -->
                <Border Grid.Row="4"
                        Height="1"
                        Background="#E5E7EB"
                        Margin="0,0,0,15"/>


                <!-- DATA COPIED -->
                <Grid Grid.Row="5"
                      Margin="0,0,0,15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Data Copied"
                               FontSize="15"
                               Foreground="#374151"/>

                    <TextBlock x:Name="DataCopiedText"
                               Grid.Column="1"
                               Text="0 MB"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>

                </Grid>


                <!-- DURATION -->
                <Grid Grid.Row="6"
                      Margin="0,0,0,15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Duration"
                               FontSize="15"
                               Foreground="#374151"/>

                    <TextBlock x:Name="DurationText"
                               Grid.Column="1"
                               Text="00:00:00"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>

                </Grid>


                <!-- SPEED -->
                <Grid Grid.Row="7">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Average Speed"
                               FontSize="15"
                               Foreground="#374151"/>

                    <TextBlock x:Name="AverageSpeedText"
                               Grid.Column="1"
                               Text="0 MB/s"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>

                </Grid>

            </Grid>

        </Border>


        <!-- BUTTON -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="OK"
                    Width="100"
                    Height="36"
                    Click="Ok_Click"/>

        </StackPanel>

    </Grid>

</Window>